{
  "name": "repo-root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate:dev": "pnpm --filter @repo/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/db migrate:deploy",
    "db:push": "pnpm --filter @repo/db push",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:seed": "pnpm --filter @repo/db seed",
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start",
    "api:lint": "pnpm --filter api lint",
    "api:check-types": "pnpm --filter api check-types",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "web:lint": "pnpm --filter web lint",
    "web:check-types": "pnpm --filter web check-types",
    "atlas:dev": "pnpm --filter atlas dev",
    "atlas:build": "pnpm --filter atlas build",
    "atlas:start": "pnpm --filter atlas start",
    "atlas:lint": "pnpm --filter atlas lint",
    "atlas:check-types": "pnpm --filter atlas check-types"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  }
}
