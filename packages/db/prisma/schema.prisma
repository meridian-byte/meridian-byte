// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  USER
  ADMIN
  DEV
}

enum SyncStatus {
  PENDING
  SYNCED
  SAVED
  ERROR
  DELETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EntityType {
  TASK
  EVENT
  NOTE
  TRANSACTION
}

enum MetricType {
  NUMBER
  CURRENCY
  DURATION
  BOOLEAN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Priority {
  URGENT_IMPORTANT
  NOT_URGENT_IMPORTANT
  URGENT_UNIMPORTANT
  NOT_URGENT_UNIMPORTANT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  ANNUALLY
}

//
// CORE
//

model User {
  id       String @id @default(cuid())
  userCode String @map("user_code") // more user friendly identification string than cuid

  accounts Account[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userCode])
  @@map("users")
}

model Account {
  id    String @id @default(cuid())
  email String
  role  Role   @default(USER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  sessions   Session[]
  profiles   Profile[]
  workspaces Workspace[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  otp       String?

  // additional data that might change per session, or during a session
  timezone String?

  // allows more than 1 account per session
  accounts Account[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

//
// APP DATA
//

model Profile {
  id         String  @id @default(cuid())
  userName   String? @map("user_name")
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  phone      String?
  address    String?
  avatar     String?
  customized Boolean @default(false)

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId])
  @@unique([userName])
  @@map("profiles")
}

model Workspace {
  id   String @id @default(cuid())
  name String

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")

  events         Event[]
  notes          Note[]
  links          Link[]
  calendars      Calendar[]
  taskLists      TaskList[]
  tasks          Task[]
  recurringRules RecurringRule[]
  reminders      Reminder[]
  folders        Folder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workspaces")
}

//
// APP DATA (Actual)
//

model Folder {
  id       String  @id @default(cuid())
  name     String
  location String
  folderId String? @map("folder_id")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  calendars Calendar[]
  notes     Note[]
  taskLists TaskList[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("folders")
}

model Reminder {
  id       String   @id @default(uuid())
  remindAt DateTime @map("remind_at")
  sent     Boolean  @default(false)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String?   @map("task_id")
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String?   @map("event_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "reminders")
}

model RecurringRule {
  id        String    @id @default(uuid())
  frequency Frequency
  interval  Int       @default(1)
  endDate   DateTime? @map("end_date")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  events Event[]
  tasks  Task[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "recurring_rules")
}

model Calendar {
  id          String  @id @default(cuid())
  title       String
  description String?
  color       String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?   @map("folder_id")

  events Event[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("calendars")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false) @map("all_day")
  location    String?

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String         @map("workspace_id")
  calendar        Calendar?      @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarId      String?        @map("calendar_id")
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  recurringRuleId String?        @map("recurring_rule_id")

  reminders Reminder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model Note {
  id      String  @id @default(uuid())
  title   String
  content String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?   @map("folder_id")

  linksFrom Link[] @relation("FromLinks") // for outgoing links
  linksTo   Link[] @relation("ToLinks") // for incoming links (backlinks)

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "notes")
}

model Link {
  id String @id @default(uuid())

  from   Note   @relation("FromLinks", fields: [fromId], references: [id], onDelete: Cascade)
  fromId String @map("from_id")
  to     Note   @relation("ToLinks", fields: [toId], references: [id], onDelete: Cascade)
  toId   String @map("to_id")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromId, toId]) // to avoid duplicate links
  @@map(name: "links")
}

model TaskList {
  id          String  @id @default(cuid())
  title       String
  description String?
  color       String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?   @map("folder_id")

  tasks Task[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task_lists")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  complete    Boolean   @default(false)
  priority    Priority  @default(NOT_URGENT_UNIMPORTANT)

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String         @map("workspace_id")
  taskList        TaskList?      @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  taskListId      String?        @map("task_list_id")
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  recurringRuleId String?        @map("recurring_rule_id")

  reminders Reminder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}
