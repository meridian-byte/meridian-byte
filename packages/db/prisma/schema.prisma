// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  USER
  ADMIN
  DEV
}

enum SyncStatus {
  PENDING
  SYNCED
  SAVED
  ERROR
  DELETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EntityType {
  TASK
  EVENT
  NOTE
  TRANSACTION
}

enum MetricType {
  NUMBER
  CURRENCY
  DURATION
  BOOLEAN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Priority {
  URGENT_IMPORTANT
  NOT_URGENT_IMPORTANT
  URGENT_UNIMPORTANT
  NOT_URGENT_UNIMPORTANT
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

//
// CORE
//

model Profile {
  id         String  @id @default(cuid())
  email      String
  userName   String? @map("user_name")
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  avatar     String?
  timezone   String?
  customized Boolean @default(false)
  role       Role    @default(USER)

  workspaces     Workspace[]
  events         Event[]
  notes          Note[]
  links          Link[]
  calendars      Calendar[]
  taskLists      TaskList[]
  tasks          Task[]
  recurringRules RecurringRule[]
  reminders      Reminder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email])
  @@map("profiles")
}

model Workspace {
  id   String @id @default(cuid())
  name String

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @map("profile_id")

  events         Event[]
  notes          Note[]
  links          Link[]
  calendars      Calendar[]
  taskLists      TaskList[]
  tasks          Task[]
  recurringRules RecurringRule[]
  reminders      Reminder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workspaces")
}

//
// Pave
//

model Calendar {
  id          String  @id @default(cuid())
  title       String
  description String?
  color       String?

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  events Event[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("calendars")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false) @map("all_day")
  location    String?

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  calendar    Calendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarId  String?   @map("calendar_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("events")
}

//
// Jot
//

model Note {
  id      String  @id @default(uuid())
  title   String
  content String?

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  linksFrom Link[] @relation("FromLinks") // for outgoing links
  linksTo   Link[] @relation("ToLinks") // for incoming links (backlinks)

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "notes")
}

model Link {
  id String @id @default(uuid())

  from   Note   @relation("FromLinks", fields: [fromId], references: [id])
  fromId String @map("from_id")
  to     Note   @relation("ToLinks", fields: [toId], references: [id])
  toId   String @map("to_id")

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromId, toId]) // to avoid duplicate links
  @@map(name: "links")
}

//
// Stride
//

model TaskList {
  id          String  @id @default(cuid())
  title       String
  description String?
  color       String?

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  tasks Task[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task_lists")
}

model RecurringRule {
  id        String    @id @default(uuid())
  frequency Frequency
  interval  Int       @default(1)
  end_date  DateTime? @map("end_date")
  weekdays  String[] // 0 - monday, 6 - sunday. comma separated for multiples. eg. 0,4,6
  months    String[] // 0 - january, 12 - december. comma separated for multiples. eg. 5,7,11

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  tasks Task[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "recurring_rules")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  complete    Boolean   @default(false)
  priority    Priority  @default(NOT_URGENT_UNIMPORTANT)

  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String         @map("profile_id")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String         @map("workspace_id")
  taskList        TaskList?      @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  taskListId      String?        @map("task_list_id")
  recurring_rule  RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  recurringRuleId String?        @map("recurring_rule_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  reminders Reminder[]

  @@map("tasks")
}

model Reminder {
  id       String   @id @default(uuid())
  remindAt DateTime @map("remind_at")
  sent     Boolean  @default(false)

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String    @map("profile_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String    @map("task_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map(name: "reminders")
}
